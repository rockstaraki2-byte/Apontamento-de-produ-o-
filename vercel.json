{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-invoiced-reports",
      "schedule": "0 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/import-orders-22sep-1500-7c91e2",
      "destination": "/api/pedidos/importar?__legacy_order_import=1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/daily-invoiced-reports.ts": {
      "maxDuration": 60
    }
  }
}
