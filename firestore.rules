rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.uid == "raul"
        && request.auth.token.superAdmin == true
        && request.auth.token.tenantId == "global"
        && request.auth.token.role == "ADMIN";
    }

    function isTenantUser() {
      return signedIn()
        && request.auth.token.tenantId is string
        && request.auth.token.tenantId.size() > 0
        && request.auth.token.tenantId != "global";
    }

    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /userCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Operational documents must carry the authenticated tenantId. The global
    // account deliberately has no access to operational collections.
    match /{collection}/{documentId} {
      allow read: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId;
      allow create: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && isTenantUser()
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow update: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId;
    }

    // Nested documents and every unlisted path are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
