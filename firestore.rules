rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.uid == "raul"
        && request.auth.token.superAdmin == true
        && request.auth.token.tenantId == "global"
        && request.auth.token.role == "ADMIN";
    }

    function isTenantUser() {
      return signedIn()
        && request.auth.token.tenantId is string
        && request.auth.token.tenantId.size() > 0
        && request.auth.token.tenantId != "global";
    }

    function canViewMaintenance() {
      return isTenantUser()
        && request.auth.token.role in ["MANUTENCAO", "ADMIN", "GERENCIA", "LEITURA"];
    }

    function canManageMaintenance() {
      return isTenantUser()
        && request.auth.token.role in ["MANUTENCAO", "ADMIN", "GERENCIA"];
    }

    match /tenants/{tenantId} {
      // A tenant may read only its own configuration document. Global
      // administration reads the tenant directory through the authenticated API.
      allow read: if isTenantUser()
        && request.auth.token.tenantId == tenantId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /userCredentials/{credentialId} {
      allow read, write: if false;
    }

    // Only maintenance, management and administrators can maintain the
    // tenant's equipment registry and recurring preventive plans.
    match /maintenanceAssets/{assetId} {
      allow read: if canViewMaintenance()
        && resource.data.tenantId == request.auth.token.tenantId;
      allow create: if canManageMaintenance()
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow update: if canManageMaintenance()
        && resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if false;
    }

    match /preventiveMaintenancePlans/{planId} {
      allow read: if canViewMaintenance()
        && resource.data.tenantId == request.auth.token.tenantId;
      allow create: if canManageMaintenance()
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow update: if canManageMaintenance()
        && resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if false;
    }

    // Preventive orders use the existing maintenance history while only the
    // authorized roles can create or change records linked to a recurring plan.
    match /maintenanceOrders/{orderId} {
      allow read: if isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId;
      allow create: if isTenantUser()
        && request.resource.data.tenantId == request.auth.token.tenantId
        && (!("preventivePlanId" in request.resource.data) || canManageMaintenance());
      allow update: if isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.tenantId == request.auth.token.tenantId
        && (!("preventivePlanId" in resource.data)
          && !("preventivePlanId" in request.resource.data)
          || canManageMaintenance());
      allow delete: if isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId
        && (!("preventivePlanId" in resource.data) || canManageMaintenance());
    }

    // Delivery rows are server-managed and cannot be changed by tenant clients.
    match /maintenancePreventiveAlertDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // Operational documents must carry the authenticated tenantId. The global
    // account deliberately has no access to operational collections.
    match /{collection}/{documentId} {
      allow read: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && collection != "maintenanceAssets"
        && collection != "preventiveMaintenancePlans"
        && collection != "maintenanceOrders"
        && collection != "maintenancePreventiveAlertDeliveries"
        && isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId;
      allow create: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && collection != "maintenanceAssets"
        && collection != "preventiveMaintenancePlans"
        && collection != "maintenanceOrders"
        && collection != "maintenancePreventiveAlertDeliveries"
        && isTenantUser()
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow update: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && collection != "maintenanceAssets"
        && collection != "preventiveMaintenancePlans"
        && collection != "maintenanceOrders"
        && collection != "maintenancePreventiveAlertDeliveries"
        && isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if collection != "tenants"
        && collection != "users"
        && collection != "userCredentials"
        && collection != "maintenanceAssets"
        && collection != "preventiveMaintenancePlans"
        && collection != "maintenanceOrders"
        && collection != "maintenancePreventiveAlertDeliveries"
        && isTenantUser()
        && resource.data.tenantId == request.auth.token.tenantId;
    }

    // Nested documents and every unlisted path are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
