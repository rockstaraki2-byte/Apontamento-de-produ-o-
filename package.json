{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/guard-production-deploy.mjs && node --max-old-space-size=1280 node_modules/vite/bin/vite.js build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:order-import": "tsx --test tests/orderImport.test.ts",
    "test:teksystem-sync": "tsx --test tests/teksystemSync.test.ts",
    "test:teksystem-writer": "tsx --test tests/teksystemWriter.test.ts",
    "teksystem:writer:status": "tsx tools/teksystem-sync-agent.ts writer-status",
    "teksystem:writer:process": "tsx tools/teksystem-sync-agent.ts writer-process",
    "teksystem:writer:preview": "tsx tools/teksystem-sync-agent.ts writer-preview",
    "teksystem:writer:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/teksystem-writer-setup.ps1",
    "teksystem:health": "tsx tools/teksystem-sync-agent.ts health",
    "teksystem:validate": "tsx tools/teksystem-sync-agent.ts validate",
    "teksystem:push": "tsx tools/teksystem-sync-agent.ts push",
    "teksystem:sync": "tsx tools/teksystem-sync-agent.ts sync",
    "teksystem:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/teksystem-sync-setup.ps1",
    "teksystem:sync:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/teksystem-sync-setup.ps1 -InstallTask",
    "teksystem:firebird": "tsx tools/teksystem-firebird-reader.ts",
    "teksystem:firebird:prompt": "powershell -ExecutionPolicy Bypass -File tools/teksystem-firebird-probe.ps1",
    "pdf-agent": "node tools/order-pdf-agent.mjs",
    "pdf-agent:setup": "node tools/order-pdf-agent.mjs --setup",
    "deploy:guard": "node scripts/guard-production-deploy.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@google/genai": "^2.8.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "acorn": "^8.17.0",
    "acorn-jsx": "^5.0.2",
    "acorn-typescript": "^1.4.13",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.4",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.40.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-firebird": "2.17.0",
    "nodemailer": "^8.0.11",
    "pdf-parse": "^1.1.1",
    "pdf-parse-debugging-disabled": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jimp": "^1.6.1",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.3"
  }
}
